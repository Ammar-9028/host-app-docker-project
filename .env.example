# Copy to .env and edit.
BRAND=NestHost
BASE_DOMAIN=yourdomain.com          # demo without buying anything: 13-233-1-2.sslip.io (your EC2 IP with dashes)
PUBLIC_SCHEME=https                 # http for demo / sslip.io
PUBLIC_PORT=                        # leave empty behind Caddy (use :8000 only for local runs)
SERVER_IP=13.233.1.2                # public IP of the server (used to verify custom domains)
ADMIN_EMAIL=you@example.com         # this email becomes admin on signup (the first user is admin too)
ACME_EMAIL=you@example.com
CADDYFILE=Caddyfile                 # Caddyfile = HTTPS, Caddyfile.http = HTTP only
MAX_SITES_PER_USER=3
MAX_SITE_MB=50
SIGNUP_OPEN=1
