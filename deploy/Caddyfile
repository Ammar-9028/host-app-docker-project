# Automatic HTTPS for the main domain, every user subdomain and verified custom domains.
# Certificates are issued on first visit, but ONLY for hostnames the app approves (/internal/tls-check).
{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://app:8000/internal/tls-check
	}
}
https:// {
	tls {
		on_demand
	}
	encode gzip
	reverse_proxy app:8000
}
http:// {
	redir https://{host}{uri} permanent
}
